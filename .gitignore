# Dependencies
node_modules/
/.pnp
.pnp.js

# Build output
dist/
build/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript / ESLint incremental build info
*.tsbuildinfo
.eslintcache

# Testing
coverage/

# Supabase CLI local state (only present if `supabase start`/`supabase init`
# has been run locally — migrations/ itself stays tracked)
supabase/.branches/
supabase/.temp/

# Playwright (installed with --no-save for one-off live-browser verification,
# never a persisted devDependency; these dirs only appear if a run is
# interrupted before cleanup)
test-results/
playwright-report/
playwright/.cache/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Cache
.cache/

# Claude Code local state (has its own nested .git + machine-specific
# settings.local.json — not project source)
.claude/